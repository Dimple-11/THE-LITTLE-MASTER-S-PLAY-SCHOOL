@"
# Dependencies
node_modules/
.pnpm-store/

# Production build
dist/
build/

# Environment variables and secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Deployment
.vercel/
.netlify/

# Testing
coverage/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Temporary files
*.tmp
*.temp
"@ | Set-Content .gitignore